# Pi client configuration – copy this file to config.py and adjust values.

# URL of the nanposweb server (no trailing slash)
SERVER_URL = 'http://your-server:5000'

# Shared secret – must match NFC_API_KEY in the server's instance/config.py.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY = 'change-me'

# ---- Display behaviour -------------------------------------------------

# Seconds of inactivity before the screen returns to idle
IDLE_TIMEOUT = 60

# Port for the local Flask web server (browse to http://localhost:<PORT>)
PORT = 8080

# Pre-defined top-up amounts shown as quick buttons in the admin panel (euros)
TOPUP_AMOUNTS = [10, 20, 30, 50]

# List of calendars to display on the idle screen
# Supported keys:
#   'url': HTTP(S) URL or local file path to an .ics file
#   'name': Display name of the calendar (e.g. 'Fachschaft', 'Partys')
#   'color': CSS color hex code or name (e.g. '#0d6efd', '#198754', '#dc3545', '#fd7e14')
CALENDARS = [
    # {'url': 'https://example.com/kalender.ics', 'color': '#0d6efd', 'name': 'Fachschaft'},
    # {'url': 'https://example.com/events.ics', 'color': '#fd7e14', 'name': 'Events'},
]

# Maximum number of upcoming calendar events to display on the idle screen
CALENDAR_EVENT_LIMIT = 8

# Number of debtors shown in the Most Wanted list on the idle screen
MOST_WANTED_LIMIT = 10

# ---- Display behaviour (Hardware) --------------------------------------

# GPIO pin for a PIR motion sensor (e.g. 17). Set to None to disable.
PIR_PIN = 17

# Seconds with no motion before the screen turns off.
DISPLAY_TIMEOUT = 120


# ---- NFC reader --------------------------------------------------------

# Set NFC_MOCK = True to simulate card scans without real hardware (testing)
NFC_MOCK = False

# UID returned by the mock reader (must be registered in the server DB)
NFC_MOCK_UID = '04AABBCCDD'

# Seconds between simulated card events in mock mode
NFC_MOCK_DELAY = 3.0

# Seconds between NFC polling attempts while idle
NFC_POLL_INTERVAL = 0.3

# nfcpy device path – 'usb' for first USB reader, e.g. 'usb:072f:2200' for a
# specific device, 'tty:S0:pn532' for a PN532 on /dev/ttyS0.
# Alternatively, use 'rc522' for an SPI-connected MFRC522 reader.
NFC_PATH = 'usb'
